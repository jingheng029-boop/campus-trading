{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS_PYTHON",
    "buildCommand": "pip install -r requirements.txt && cp instance/campus_trading.db campus_trading.db",
    "start": "python app.py"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
